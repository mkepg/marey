{
  "name": "marey",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "bin": {
    "marey": "bin/marey.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:cli": "vite build --config vite.cli.config.ts",
