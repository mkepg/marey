    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build:cli && node bin/marey.mjs check"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "matter-js": "0.20.0",
    "monaco-editor": "^0.53.0",
    "pixi.js": "^8.16.0",
    "preact": "^10.27.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@types/lz-string": "^1.3.34",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^24.10.1",
    "lottie-web": "^5.13.0",
    "playwright": "^1.62.1",
    "sass": "^1.97.3",
    "typescript": "~5.9.3",
    "vite": "^8.0.0-beta.13",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "vite": "^8.0.0-beta.13"
  }
