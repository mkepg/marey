// Bar chart reveal: seven values grow into bars, one after another.
// Each bar pivots on the baseline (origin (0.5, 1)), so scaling in y grows it upward.

let values   = [3, 7, 2, 9, 5, 8, 4]
let unit     = 30           // pixels per unit of value
let baseline = 500
let step     = 800 / (length(values) + 1)

scene {
  size: (800, 600)
  duration: 4
  background: #1a1b41

  text title {
    position: (400, 60), content: "Sales by week", fontSize: 24, color: #f5e6d3
  }

  line baselineRule {
    position: (400, baseline), points: [(-350, 0), (350, 0)]
    thickness: 2, color: #7a4f8a
  }

  generate v, i in values {
    rectangle bar {
      position: (step * (i + 1), baseline)
      size: (step - 30, v * unit)
      color: #feb93e
      origin: (0.5, 1)
      scale: (1, 0)
      animate {
        property: scale, to: (1, 1), duration: 0.6
        delay: 0.3 + i * 0.25, easing: easeOut
      }
    }
  }
}
