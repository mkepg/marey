// Yellow flowers, after the popular "yellow flowers" CSS animation.
// A bush grows once, in about two and a half seconds; then hearts and fireflies drift for good.
// Curves are circles squashed into ellipses, and every glow is a stack of faint circles.

let gold     = #ffd23f  let goldLit  = #ffe682  let goldDeep = #f2a91d  let cream = #fff4cf
let leafDeep = #1f8f4e  let leaf     = #34b862  let leafLit  = #6fdc8f  let stem  = #2fa95a
let rose     = #ff5d73  let mint     = #7cefc2  let firefly  = #fff3a6

// A unit circle of 36 points, for the bubbles' outlines.
let circlePts = [(1, 0), (0.985, 0.174), (0.940, 0.342), (0.866, 0.5), (0.766, 0.643), (0.643, 0.766),
            (0.5, 0.866), (0.342, 0.940), (0.174, 0.985), (0, 1), (-0.174, 0.985), (-0.342, 0.940),
            (-0.5, 0.866), (-0.643, 0.766), (-0.766, 0.643), (-0.866, 0.5), (-0.940, 0.342),
            (-0.985, 0.174), (-1, 0), (-0.985, -0.174), (-0.940, -0.342), (-0.866, -0.5),
            (-0.766, -0.643), (-0.643, -0.766), (-0.5, -0.866), (-0.342, -0.940), (-0.174, -0.985),
            (0, -1), (0.174, -0.985), (0.342, -0.940), (0.5, -0.866), (0.643, -0.766),
            (0.766, -0.643), (0.866, -0.5), (0.940, -0.342), (0.985, -0.174), (1, 0)]

// Petals, back to front: [angle, length, width as a fraction of length, front?].
let petals = [[0, 58, 0.62, 0], [-30, 54, 0.6, 0], [30, 54, 0.6, 0], [-62, 50, 0.58, 1], [62, 50, 0.58, 1]]

// Each stem's leaves: [height fraction, side, length].
let stemLeaves = [[[0.22, 1, 54], [0.24, -1, 54], [0.4, 1, 52], [0.42, -1, 50], [0.58, 1, 46], [0.6, -1, 46], [0.76, 1, 38], [0.78, -1, 36]],
                  [[0.3, -1, 50], [0.32, 1, 46], [0.52, -1, 44], [0.64, 1, 40], [0.66, -1, 38]],
                  [[0.3, 1, 50], [0.42, -1, 46], [0.54, 1, 46], [0.68, 1, 38], [0.7, -1, 36]],
                  [[0.42, -1, 44], [0.5, 1, 40], [0.66, -1, 34]],
                  [[0.48, -1, 38], [0.62, 1, 32]]]

// A leaf is an ellipse along +x from its base, with a lit upper half and a vein.
// It unfurls at `at`.
template Leaf(len, at, deep, lit) {
  group unfurl {
    scale: 0
    animate { property: scale, to: 1, duration: 0.45, delay: at, easing: easeOut }
    circle body  { position: (len / 2, 0), radius: len / 2, scale: (1, 0.36), color: deep }
    circle shine { position: (len * 0.52, -len * 0.05), radius: len * 0.4, scale: (1, 0.22), color: lit }
    line vein    { position: (len * 0.45, 0), points: [(0, 0), (len * 0.82, 0)], thickness: 1.4, color: deep }
  }
}

// A flower opens at `at`: five ellipse petals fanned from a cup, the back ones
// deeper, each with a lit tip, a glow of faint circles, and a pale lip on the
// cup. It then sways on its stem.
template Flower(at, sway) {
  group bloom {
    scale: 0
    animate { property: scale, to: 1, duration: 0.6, delay: at, easing: easeOut }
    group swing {
      rotation: -sway
      animate { property: rotation, to: sway, duration: 2, loop: true, yoyo: true }
      generate i in 0 to 9 {
        circle glow { position: (0, -30), radius: 100 - i * 6, color: gold, alpha: 0.018 }
      }
      generate p in petals {
        group petal {
          position: (0, -10), rotation: p[0]
          circle body { position: (0, -p[1] / 2), radius: p[1] / 2, scale: (p[2], 1), color: if p[3] == 1 then gold else goldDeep }
          circle tip  { position: (0, -p[1] * 0.6), radius: p[1] * 0.3, scale: (p[2] * 0.9, 1), color: goldLit }
        }
      }
      circle cup { position: (0, -8), radius: 32, scale: (1, 0.56), color: gold }
      circle lip { position: (0, -16), radius: 22, scale: (1, 0.24), color: cream }
      circle dew { position: (-9, -4), radius: 5, scale: (1, 0.6), color: goldLit }
    }
  }
}

// A stem grows up from its base at `at`, its leaves unfurling as it passes them,
// and opens a flower at its tip, turned `turn` degrees back towards upright.
// Its leaves are `stemLeaves[k]`.
template Stem(len, at, grow, size, turn, k) {
  group shaft {
    scale: (1, 0)
    animate { property: scale, to: (1, 1), duration: grow, delay: at, easing: easeOut }
    line stalk { position: (0, 0), origin: (0.5, 1), points: [(0, 0), (0, -len)], thickness: 5, color: stem }
    line gleam { position: (-1, 0), origin: (0.5, 1), points: [(0, 0), (0, -len)], thickness: 1.5, color: leafLit, alpha: 0.6 }
  }
  generate l in stemLeaves[k] {
    use Leaf(l[2], at + grow * l[0] * 0.55, if l[1] > 0 then leaf else leafDeep, leafLit) leaf {
      position: (0, -len * l[0]), rotation: if l[1] > 0 then -36 else 216
    }
  }
  use Flower(at + grow - 0.15, 3) flower { position: (0, -len), rotation: turn, scale: size }
}

// A grass blade `h` tall whose tip leans `bend` sideways (|bend| >= w), curving
// as it rises. The polygon sits at its bounding box's centre, so its base lands
// on the pivot, where it rises at `at` and then sways.
template Blade(h, bend, w, at, c) {
  group sway {
    animate { property: rotation, to: if bend >= 0 then 3 else -3, duration: 2.6, loop: true, yoyo: true }
    group rise {
      scale: (1, 0)
      animate { property: scale, to: (1, 1), duration: 0.8, delay: at, easing: easeOut }
      polygon blade {
        position: (if bend >= 0 then (bend - w) / 2 else (bend + w) / 2, -h / 2), color: c
        points: [(-w, 0), (bend * 0.04 - w * 0.8, -0.2 * h), (bend * 0.16 - w * 0.6, -0.4 * h),
                 (bend * 0.36 - w * 0.4, -0.6 * h), (bend * 0.64 - w * 0.2, -0.8 * h),
                 (bend * 0.85 - w * 0.08, -0.92 * h), (bend, -h),
                 (bend * 0.85 + w * 0.08, -0.92 * h), (bend * 0.64 + w * 0.2, -0.8 * h),
                 (bend * 0.36 + w * 0.4, -0.6 * h), (bend * 0.16 + w * 0.6, -0.4 * h),
                 (bend * 0.04 + w * 0.8, -0.2 * h), (w, 0)]
      }
    }
  }
}

// A heart is a square turned 45 degrees with a circle on each upper side. It
// rises from below the scene to above it every `period` seconds, swaying as it
// goes; it never fades, because a fading group fades each of its overlapping
// shapes on its own. `ring` is the alpha of its bubble.
template Heart(size, period, at, drift, ring) {
  group float {
    animate { property: position, to: (drift, -720), duration: period, delay: at, easing: linear, loop: true }
    group sway {
      position: (-8, 0)
      animate { property: position, to: (8, 0), duration: 1.6, loop: true, yoyo: true }
      circle tint { position: (0, 0), radius: size * 1.15, color: mint, alpha: ring * 0.1 }
      line edge   { position: (0, 0), points: circlePts, scale: size * 1.15, thickness: 0.07, color: mint, alpha: ring }
      group heart {
        position: (0, size * 0.12)
        rectangle body { position: (0, 0), size: (size * 0.71, size * 0.71), rotation: 45, color: rose }
        generate s in [-1, 1] {
          circle lobe { position: (s * size * 0.25, -size * 0.25), radius: size * 0.355, color: rose }
        }
        circle gloss { position: (-size * 0.27, -size * 0.32), radius: size * 0.1, color: #ffffff, alpha: 0.55 }
      }
    }
  }
}

// A firefly: a bright core in a soft glow, drifting and pulsing on its own beat.
template Firefly(beat, dx, dy, at) {
  group light {
    alpha: 0
    animate { property: alpha, to: 1, duration: beat, delay: at, loop: true, yoyo: true }
    animate { property: position, to: (dx, dy), duration: beat * 2.5, loop: true, yoyo: true }
    circle halo { position: (0, 0), radius: 10, color: gold, alpha: 0.14 }
    circle haze { position: (0, 0), radius: 5.5, color: gold, alpha: 0.3 }
    circle core { position: (0, 0), radius: 2.2, color: firefly }
  }
}

let starAt = [(40, 30), (130, 90), (210, 40), (300, 120), (380, 60), (590, 40), (660, 110),
              (740, 50), (820, 130), (900, 70), (60, 200), (170, 260), (860, 240), (930, 180),
              (250, 330), (700, 330), (100, 380), (890, 360), (620, 200), (340, 220)]
let fireAt = [(420, 120), (455, 92), (520, 105), (560, 150), (600, 210), (395, 200), (430, 300),
              (520, 230), (610, 260), (330, 330), (300, 400), (640, 170), (350, 270), (580, 95)]

// Blades: [x, height, bend, width, start]. Hearts: [x, size, period, start, ring].
let grass  = [[110, 120, -20, 4, 2.0], [140, 180, -18, 5, 1.8], [160, 240, 12, 5, 1.6], [178, 150, 26, 6, 1.9],
              [205, 210, -12, 4.5, 1.7], [228, 130, 22, 5, 2.1], [252, 170, 30, 5, 2.2],
              [730, 200, 14, 5, 1.7], [752, 262, -14, 5.5, 1.6], [772, 170, 30, 5, 2.0], [792, 232, -22, 5, 1.8],
              [816, 190, 18, 4.5, 2.1], [842, 140, -24, 5, 2.2], [864, 220, 10, 5, 1.9],
              [432, 90, -14, 4, 1.5], [540, 104, 18, 4, 1.6]]
let sweeps = [[492, 300, 190, 9, 1.8], [500, 236, 150, 8, 2.0], [470, 216, -122, 8, 2.1]]
let hearts = [[120, 30, 12, 0, 0.9], [300, 24, 10, 1.6, 0], [620, 34, 11, 0.6, 0.9], [820, 26, 11, 2.6, 0],
              [540, 22, 9, 3.4, 0.9], [700, 28, 12, 4.2, 0], [230, 26, 10, 5, 0.9], [900, 22, 10, 5.4, 0.9],
              [380, 22, 11, 7, 0.9]]

// The leafy base: [angle, length, start], fanned out on both sides of the stems.
let base = [[200, 120, 1.3], [222, 132, 1.4], [246, 104, 1.55], [-20, 118, 1.35], [-42, 128, 1.45],
            [-66, 100, 1.6], [212, 86, 1.7], [-32, 84, 1.75]]

scene {
  size: (960, 600)
  duration: 16
  background: #0b0f2a

  // ── Sky: violet rising from the horizon in thirty faint bands, a warm glow
  // that comes up behind the bush as it grows, and twinkling stars ──
  generate i in 0 to 29 {
    rectangle band { position: (480, i * 20 + 10), size: (960, 20), color: #3b2770, alpha: i * i * 0.0008 }
  }
  group warmth {
    alpha: 0
    animate { property: alpha, to: 1, duration: 1.5, delay: 0.6, easing: easeOut }
    generate i in 0 to 15 {
      circle glow { position: (480, 270), radius: 340 - i * 16, color: gold, alpha: 0.007 }
    }
  }
  generate p, i in starAt {
    circle star {
      position: p, radius: [1.1, 1.5, 0.9][i % 3], color: #e2e6ff, alpha: 0.55
      animate { property: alpha, to: 0.12, duration: [1.3, 1.9, 2.6][i % 3], loop: true, yoyo: true }
    }
  }

  // ── Grass at both edges ──
  generate g, i in grass {
    use Blade(g[1], g[2], g[3], g[4], [#2f9e55, #1f7a43, #46c06c][i % 3]) blade { position: (g[0], 612) }
  }

  // ── The bush: a leafy base, the sprout's first two leaves, then five stems ──
  generate b, i in base {
    use Leaf(b[1], b[2], if i % 2 == 0 then leaf else leafDeep, leafLit) base { position: (480, 606), rotation: b[0] }
  }
  use Leaf(56, 0, leaf, leafLit) sproutR { position: (482, 598), rotation: -40 }
  use Leaf(54, 0.05, leafDeep, leafLit) sproutL { position: (478, 598), rotation: 220 }
  use Stem(450, 0.15, 1.0, 1.15, 0, 0) top     { position: (480, 612), rotation: 1 }
  use Stem(350, 0.35, 0.9, 1.05, 4, 1) middle  { position: (480, 612), rotation: -6 }
  use Stem(335, 0.5, 0.9, 1.1, -10, 2) right   { position: (480, 612), rotation: 15 }
  use Stem(290, 0.7, 0.8, 1, 14, 3) left       { position: (480, 612), rotation: -21 }
  use Stem(220, 0.85, 0.8, 0.85, 28, 4) low    { position: (480, 612), rotation: -40 }

  // ── Long blades sweeping out from the base, and the ground's shadow ──
  generate g, i in sweeps {
    use Blade(g[1], g[2], g[3], g[4], #46c06c) sweep { position: (g[0], 612) }
  }
  generate i in 0 to 7 {
    rectangle ground { position: (480, 596 + i * 2), size: (960, 8), color: #04060f, alpha: 0.06 * i }
  }

  // ── Hearts in bubbles, and fireflies ──
  generate h, i in hearts {
    use Heart(h[1], h[2], h[3], if i % 2 == 0 then 36 else -36, h[4]) heart { position: (h[0], 660) }
  }
  generate p, i in fireAt {
    use Firefly([1.1, 1.5, 1.9, 1.3][i % 4], [10, -12, 8][i % 3], [-14, -8, -18][i % 3], 1.4 + (i % 5) * 0.15) fly {
      position: p
    }
  }
}
