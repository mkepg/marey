// Logo reveal: the Marey mark, a sun over three ridges, assembles and the name fades in.
// Each part rises on its own beat, and the finished lockup holds for the last second.

let sunRim  = #feb93e
let sunDisc = #fecd5e
let cream   = #f5e6d3

template Ridge(shade, delay, peaks) {
  polygon ridge {
    position: (400, 346 + 70), origin: (0.5, 1), color: shade, alpha: 0
    points: peaks
    sequence {
      parallel {
        animate { property: position, to: (400, 346), duration: 0.8, delay: delay, easing: easeOut }
        animate { property: alpha, to: 1, duration: 0.5, delay: delay }
      }
    }
  }
}

scene {
  size: (800, 600)
  duration: 5
  background: #2b2d5c

  group sun {
    position: (400, 270), scale: (0.4, 0.4), alpha: 0
    circle rim  { position: (0, 0), radius: 96, color: sunRim }
    circle disc { position: (0, -8), radius: 91, color: sunDisc }
    sequence {
      parallel {
        animate { property: position, to: (400, 236), duration: 1.1, easing: easeOut }
        animate { property: scale, to: (1, 1), duration: 1.1, easing: easeOut }
        animate { property: alpha, to: 1, duration: 0.6 }
      }
    }
  }

  use Ridge(#6b4a7a, 0.9, [(-190, 0), (-70, -84), (-10, -40), (70, -100), (190, 0)]) back {}
  use Ridge(#4a3560, 1.2, [(-190, 0), (-110, -48), (-30, -14), (50, -58), (190, 0)]) middle {}
  use Ridge(#2f2444, 1.5, [(-190, 0), (-130, -24), (-60, -2), (30, -30), (190, 0)]) front {}

  text name {
    position: (400, 470), content: "marey", fontSize: 64, color: cream, alpha: 0
    sequence {
      parallel {
        animate { property: position, to: (400, 450), duration: 0.9, delay: 2.2, easing: easeOut }
        animate { property: alpha, to: 1, duration: 0.9, delay: 2.2 }
      }
    }
  }
}
