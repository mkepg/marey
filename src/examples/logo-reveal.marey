// Logo reveal: three parts fly in one after another and lock into a mark.
// Each part has its own delay, so they arrive in sequence.

let coral = #e8846f
let amber = #feb93e

scene {
  size: (800, 600)
  duration: 4
  background: #1a1b41

  group mark {
    position: (360, 300)

    rectangle stem {
      position: (0, -300), size: (40, 200), color: coral, alpha: 0
      animate { property: position, to: (0, 0), duration: 0.8, easing: easeOut }
      animate { property: alpha, to: 1, duration: 0.5 }
    }
    rectangle armTop {
      position: (500, -70), size: (80, 40), color: amber, alpha: 0
      animate { property: position, to: (60, -70), duration: 0.8, delay: 0.7, easing: easeOut }
      animate { property: alpha, to: 1, duration: 0.5, delay: 0.7 }
    }
    rectangle armMid {
      position: (500, 18), size: (62, 40), color: amber, alpha: 0
      animate { property: position, to: (46, 18), duration: 0.8, delay: 1.4, easing: easeOut }
      animate { property: alpha, to: 1, duration: 0.5, delay: 1.4 }
    }
  }
}
