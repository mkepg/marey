// Angle in degrees from the +x axis, y down: 0 degrees is right, 90 is down.
// i * 30 - 90 starts at the top and increases clockwise on screen.
let ring = 200

scene {
  size: (800, 600)
  background: #0a0e1a

  generate i in 0 to 11 {
    let angle = i * 30 - 90
    circle dot {
      position: (400 + ring * cos(angle), 300 + ring * sin(angle))
      radius: 10
      color: cyan
    }
  }
}
