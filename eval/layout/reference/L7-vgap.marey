// The last square in every column is 2 px low, so the gap is 12.
let colx = [280, 400, 520]
let offs = [-75, -25, 25, 77]

scene {
  size: (800, 600)
  background: #0a0e1a

  generate cx, c in colx {
    group column {
      position: (cx, 300)

      generate dy in offs {
        rectangle cell {
          position: (0, dy)
          size: (40, 40)
          color: green
        }
      }
    }
  }
}
