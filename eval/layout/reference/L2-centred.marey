// The whole row is 2 px right of centre.
let xs = [248, 344, 460, 546]
let ys = [375, 375, 375, 375]
let ws = [40, 120, 80, 60]
let hs = [50, 50, 50, 50]

scene {
  size: (800, 600)
  background: #0a0e1a

  generate x, i in xs {
    rectangle shape {
      position: (x, ys[i])
      size: (ws[i], hs[i])
      color: cyan
    }
  }
}
