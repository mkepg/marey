// 3 columns x 4 rows of 120x80 cards, 24 apart, centred.
let xs = [256, 400, 544, 256, 400, 544, 256, 400, 544, 256, 400, 544]
let ys = [144, 144, 144, 248, 248, 248, 352, 352, 352, 456, 456, 456]

scene {
  size: (800, 600)
  background: #0a0e1a

  generate x, i in xs {
    rectangle cell {
      position: (x, ys[i])
      size: (120, 80)
      color: magenta
    }
  }
}
