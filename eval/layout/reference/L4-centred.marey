// The whole stack is 2 px below centre.
let xs = [270, 210, 240]
let ys = [242, 302, 362]
let ws = [300, 180, 240]
let hs = [30, 30, 30]

scene {
  size: (800, 600)
  background: #0a0e1a

  generate x, i in xs {
    rectangle shape {
      position: (x, ys[i])
      size: (ws[i], hs[i])
      color: green
    }
  }
}
