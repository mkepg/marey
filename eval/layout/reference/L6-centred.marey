// The whole grid is 2 px right of centre.
let xs = [258, 402, 546, 258, 402, 546, 258, 402, 546, 258, 402, 546]
let ys = [144, 144, 144, 248, 248, 248, 352, 352, 352, 456, 456, 456]

scene {
  size: (800, 600)
  background: #0a0e1a

  generate x, i in xs {
    rectangle cell {
      position: (x, ys[i])
      size: (120, 80)
      color: magenta
    }
  }
}
