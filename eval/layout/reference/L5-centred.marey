// The whole row is 2 px right of centre.
let xs = [202, 302, 402, 502, 602]
let ys = [300, 300, 300, 300, 300]

template Badge() {
  circle disc {
    position: (0, 0)
    radius: 30
    color: cyan
  }
  rectangle pip {
    position: (0, 0)
    size: (20, 20)
    color: white
  }
}

scene {
  size: (800, 600)
  background: #0a0e1a

  generate x, i in xs {
    use Badge() badge { position: (x, ys[i]) }
  }
}
