// The long tick that belongs at 50 is at 51.
let ring = 220

scene {
  size: (800, 600)
  background: #0a0e1a

  generate i in 0 to 59 {
    let a = i * 6
    let h = if i % 5 == 0 then 32 else 16
    rectangle tick {
      position: (400 + (220) * sin(a), 300 - (220) * cos(a))
      size: (4, (if i == 51 then 32 else if i == 50 then 16 else h))
      rotation: a
      color: white
    }
  }
}
