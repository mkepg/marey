// Circle 4 is on a ring of radius 202.
let n = 12
let ring = 200

scene {
  size: (800, 600)
  background: #0a0e1a

  generate i in 0 to n - 1 {
    let a = i * 30
    circle dot {
      position: (400 + (ring + if i == 4 then 2 else 0) * sin(a), 300 - (ring + if i == 4 then 2 else 0) * cos(a))
      radius: 10
      color: orange
    }
  }
}
