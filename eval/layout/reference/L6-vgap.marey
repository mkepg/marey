// The fourth row is 2 px low, so the gap is 26.
let xs = [256, 400, 544, 256, 400, 544, 256, 400, 544, 256, 400, 544]
let ys = [144, 144, 144, 248, 248, 248, 352, 352, 352, 458, 458, 458]

scene {
  size: (800, 600)
  background: #0a0e1a

  generate x, i in xs {
    rectangle cell {
      position: (x, ys[i])
      size: (120, 80)
      color: magenta
    }
  }
}
