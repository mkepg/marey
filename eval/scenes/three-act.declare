// A square that first rotates 180 degrees, then slides right while
// growing at the same time, then falls under gravity. Strictly in
// that order, one step at a time.

scene {
  size: (800, 600)
  background: #0a0e1a
  sceneFit: contain

  rectangle actor {
    position: (150, 300)
    size: (60, 60)
    color: #fb7185
    sequence {
      animate {
        property: rotation
        to: 180
        duration: 0.9
        easing: easeInOut
      }
      parallel {
        animate { property: position, to: (500, 300), duration: 1.2, easing: easeInOut }
        animate { property: scale,    to: (1.8, 1.8), duration: 1.2, easing: easeOut }
      }
      physics {
        gravity: (0, 900)
        bounce: 0.4
        collideBounds: true
        duration: 3.0
      }
    }
  }
}
