// Nine circles in a row, growing from small on the left to large
// on the right. Both position and radius are derived from the loop
// index i via simple arithmetic (i * spacingX, i * radiusStep).

let ink  = #e2e8f0
let sky  = #38bdf8

let startX     = 100
let spacingX   = 75
let rowY       = 300
let baseRadius = 15
let radiusStep = 8

scene {
  size: (800, 600)
  background: #0a0e1a
  fit: contain

  text title {
    position: (400, 40)
    content: "scale ramp"
    fontSize: 20
    color: ink
  }

  generate i in 0 to 8 {
    circle dot {
      position: (startX + i * spacingX, rowY)
      radius: baseRadius + i * radiusStep
      color: sky
    }
  }
}
