// Horizontal axis with eleven evenly spaced tick marks; every fifth tick
// (the 1st, 6th, and 11th — indices 0, 5, 10 of 11) is drawn longer.
//
// docs/LANGUAGE.md "Current limits" states there is no modulo and no
// conditional, so "every fifth tick is taller" cannot be branched on inside
// a single generate loop, and prescribes exactly this workaround: two
// overlapping generate loops, the second at a wider stride drawing over the
// first. That is what's used below — the second loop's index j stands for
// the real tick index i = j * 5, so it only visits 0, 5, 10.

let axisY  = 300
let startX = 100
let spacing = 60
let shortHalf = 5
let longHalf  = 12

scene {
  size: (800, 600)
  background: #0a0e1a

  line axis {
    position: (400, axisY)
    points: [(-300, 0), (300, 0)]
    thickness: 2
    color: white
  }

  // All eleven ticks, short by default.
  generate i from 0 to 10 {
    line tick {
      position: (startX + i * spacing, axisY)
      points: [(0, -shortHalf), (0, shortHalf)]
      thickness: 2
      color: white
    }
  }

  // Every fifth tick (i = j * 5 -> 0, 5, 10), drawn longer, on top.
  generate j from 0 to 2 {
    line tickMajor {
      position: (startX + (j * 5) * spacing, axisY)
      points: [(0, -longHalf), (0, longHalf)]
      thickness: 2
      color: white
    }
  }
}
