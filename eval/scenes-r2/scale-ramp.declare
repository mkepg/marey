// Nine circles in a row, growing from small on the left to large on the
// right. Both the x position and the radius are linear functions of the
// loop variable, matching the pattern already shown in docs/LANGUAGE.md's
// own examples (e.g. `position: (400, 100 + i * 60)` and
// `duration: 0.9 + k / 12`), so this is fully generated with no
// hand-unrolling and no real uncertainty.

let startX  = 100
let stepX   = 75
let minR    = 10
let stepR   = 6

scene {
  size: (800, 600)
  background: #0a0e1a

  generate i from 0 to 8 {
    circle dot {
      position: (startX + i * stepX, 300)
      radius: minR + i * stepR
      color: magenta
    }
  }
}
