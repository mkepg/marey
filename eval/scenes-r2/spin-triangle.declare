scene {
  size: (800, 600)
  background: #0a0e1a

  group spinner {
    position: (400, 300)
    animate {
      property: rotation
      to: 360
      duration: 3.0
      easing: linear
      loop: true
    }
    polygon triangle {
      position: (0, 0)
      points: [(0, -40), (35, 20), (-35, 20)]
      color: white
    }
  }
}
