scene {
  size: (800, 600)
  background: #0a0e1a

  circle ball {
    position: (400, 60)
    radius: 30
    color: cyan
    physics {
      gravity: (0, 980)
      bounce: 0.6
      collideBounds: true
      duration: indefinitely
    }
  }

  line floor {
    position: (400, 596)
    points: [(-380, 0), (380, 0)]
    thickness: 2
    color: white
    alpha: 0.35
  }
}
