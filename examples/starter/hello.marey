let ink  = #f8fafc
let teal = #2dd4bf

scene {
  size: (640, 360)
  background: #0f172a
  duration: 2

  circle dot {
    position: (120, 180)
    radius: 36
    color: teal
    animate {
      property: position
      to: (520, 180)
      duration: 1.6
      easing: easeInOut
    }
  }

  rectangle bar {
    position: (320, 280)
    size: (360, 8)
    color: ink
    origin: (0.5, 0.5)
    scale: (0, 1)
    animate {
      property: scale
      to: (1, 1)
      duration: 1.2
      easing: easeOut
    }
  }
}
