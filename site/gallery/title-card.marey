// A broadcast title card. A frame opens, two accent bars wipe
// in, the title rises into place, an underline draws under it
// and a subtitle follows. Everything holds for two seconds, then
// leaves in the reverse order, each part a beat after the last.
//
// Every part that enters and leaves has one `sequence`: wait,
// enter, hold, leave. The frame, which opens at 0, has no wait.
// A wait or a hold is an `animate` to the value the part already
// has, which changes nothing for its `duration`. Each part's steps
// add up to the moment it should move, so the parts never refer
// to each other. The timeline:
//
//   0.0  frame opens          4.4  subtitle leaves
//   0.3  top bar wipes in     4.6  underline fades
//   0.5  bottom bar           4.8  title leaves
//   0.6  title rises          5.0  bottom bar wipes out
//   1.3  underline draws      5.2  top bar wipes out
//   1.7  subtitle             5.6  frame closes
//
// The last part is gone at 6 s, and the light shafts behind
// are back where they started at 7 s, so the scene ends as it
// began, on the empty background, and loops without a seam.

scene {
  size: (960, 540)
  duration: 7
  background: #0e1117

  // ── Background ── Two slanted shafts of light drift slowly left
  // and back: a once-only yoyo of 3.5 s each way, so they finish
  // where they started at 7 s. easeInOut brings them to rest at
  // both ends, so nothing jumps when the scene starts again. A warm
  // glow sits behind the title: ten faint circles in small steps
  // of alpha, so no edge shows. Neither is part of the sequence.
  polygon shaftA { position: (360, 270), color: #f4efe6, alpha: 0.035
                   points: [(-60, -270), (120, -270), (20, 270), (-160, 270)]
                   animate { property: position, to: (300, 270), duration: 3.5, easing: easeInOut, yoyo: true } }
  polygon shaftB { position: (700, 270), color: #f4efe6, alpha: 0.025
                   points: [(-30, -270), (50, -270), (-40, 270), (-120, 270)]
                   animate { property: position, to: (640, 270), duration: 3.5, easing: easeInOut, yoyo: true } }
  circle glow10 { position: (480, 262), radius: 330, color: #ff7a4a, alpha: 0.012 }
  circle glow9 { position: (480, 262), radius: 290, color: #ff7a4a, alpha: 0.012 }
  circle glow8 { position: (480, 262), radius: 252, color: #ff7a4a, alpha: 0.012 }
  circle glow7 { position: (480, 262), radius: 216, color: #ff8052, alpha: 0.012 }
  circle glow6 { position: (480, 262), radius: 182, color: #ff8052, alpha: 0.012 }
  circle glow5 { position: (480, 262), radius: 150, color: #ff8a5c, alpha: 0.012 }
  circle glow4 { position: (480, 262), radius: 120, color: #ff8a5c, alpha: 0.012 }
  circle glow3 { position: (480, 262), radius: 92, color: #ff9466, alpha: 0.012 }
  circle glow2 { position: (480, 262), radius: 66, color: #ff9a6e, alpha: 0.012 }
  circle glow1 { position: (480, 262), radius: 42, color: #ffa47a, alpha: 0.012 }

  // ── Frame ── Four corner marks, a label and a seven-second ruler,
  // in one group on the centre of the scene. The group starts at
  // `scale: 0`, so everything in it is folded into that one point;
  // scaling the group to 1 opens them out to their places, and
  // back to 0 closes them again. The marks are written about the
  // group's (0, 0), so the group's pivot is the frame's centre.
  group frame {
    position: (480, 270)
    scale: 0
    sequence {
      animate { property: scale, to: 1, duration: 0.5, easing: easeOut }
      animate { property: scale, to: 1, duration: 5.1 }
      animate { property: scale, to: 0, duration: 0.4, easing: easeIn }
    }

    // Each mark's `origin` is its corner, so its `position` is
    // where the corner sits.
    line cornerTL { position: (-410, -210), origin: (0, 0), thickness: 2, color: #5d6678
                    points: [(0, 28), (0, 0), (28, 0)] }
    line cornerTR { position: (410, -210), origin: (1, 0), thickness: 2, color: #5d6678
                    points: [(-28, 0), (0, 0), (0, 28)] }
    line cornerBL { position: (-410, 210), origin: (0, 1), thickness: 2, color: #5d6678
                    points: [(0, -28), (0, 0), (28, 0)] }
    line cornerBR { position: (410, 210), origin: (1, 1), thickness: 2, color: #5d6678
                    points: [(-28, 0), (0, 0), (0, -28)] }
    text label { position: (-386, -186), origin: (0, 0.5), content: "06  SEQUENCE", fontSize: 13, color: #8a93a6 }

    // The ruler marks the scene's seconds, and the playhead crosses
    // it in exactly 7 s. The playhead moves in the frame's space
    // while the frame scales, so the two motions add up.
    line ruler { position: (0, 196), thickness: 1, color: #3a4152, points: [(-140, 0), (140, 0)] }
    line tick0 { position: (-140, 192), thickness: 1, color: #3a4152, points: [(0, -4), (0, 4)] }
    line tick1 { position: (-100, 192), thickness: 1, color: #3a4152, points: [(0, -4), (0, 4)] }
    line tick2 { position: (-60, 192),  thickness: 1, color: #3a4152, points: [(0, -4), (0, 4)] }
    line tick3 { position: (-20, 192),  thickness: 1, color: #3a4152, points: [(0, -4), (0, 4)] }
    line tick4 { position: (20, 192),   thickness: 1, color: #3a4152, points: [(0, -4), (0, 4)] }
    line tick5 { position: (60, 192),   thickness: 1, color: #3a4152, points: [(0, -4), (0, 4)] }
    line tick6 { position: (100, 192),  thickness: 1, color: #3a4152, points: [(0, -4), (0, 4)] }
    line tick7 { position: (140, 192),  thickness: 1, color: #3a4152, points: [(0, -4), (0, 4)] }
    rectangle playhead { position: (-140, 192), size: (3, 12), color: #ff5a36
                         animate { property: position, to: (140, 192), duration: 7, easing: linear } }
  }

  // ── The card ── Bars, title, underline and subtitle, in one group
  // that pushes in by 4% over the whole scene, a slow camera move.
  // Each part keeps its own sequence; the push is the group's.
  group card {
    position: (480, 252)
    animate { property: scale, to: 1.04, duration: 7, easing: linear }

    // The bars wipe in from no width. `origin` pins the end a bar
    // grows from: the left end for the top bar, the right end for
    // the bottom one, so they open towards each other. Each thin
    // amber edge follows its bar 0.15 s later, and leaves before it.
    // On the way out the bars shrink back to the end they grew
    // from, and fade, in one `parallel` step.
    rectangle barTop {
      position: (-270, -64), origin: (0, 0.5), size: (300, 10), color: #ff5a36
      scale: (0, 1)
      sequence {
        animate { property: scale, to: (0, 1), duration: 0.3 }
        animate { property: scale, to: (1, 1), duration: 0.5, easing: easeOut }
        animate { property: scale, to: (1, 1), duration: 4.4 }
        parallel {
          animate { property: scale, to: (0, 1), duration: 0.4, easing: easeIn }
          animate { property: alpha, to: 0, duration: 0.4 }
        }
      }
    }
    rectangle edgeTop {
      position: (-270, -54), origin: (0, 0.5), size: (180, 3), color: #ffb547
      scale: (0, 1)
      sequence {
        animate { property: scale, to: (0, 1), duration: 0.45 }
        animate { property: scale, to: (1, 1), duration: 0.5, easing: easeOut }
        animate { property: scale, to: (1, 1), duration: 4.15 }
        parallel {
          animate { property: scale, to: (0, 1), duration: 0.4, easing: easeIn }
          animate { property: alpha, to: 0, duration: 0.4 }
        }
      }
    }
    rectangle barBottom {
      position: (270, 108), origin: (1, 0.5), size: (220, 10), color: #ff5a36
      scale: (0, 1)
      sequence {
        animate { property: scale, to: (0, 1), duration: 0.5 }
        animate { property: scale, to: (1, 1), duration: 0.5, easing: easeOut }
        animate { property: scale, to: (1, 1), duration: 4 }
        parallel {
          animate { property: scale, to: (0, 1), duration: 0.4, easing: easeIn }
          animate { property: alpha, to: 0, duration: 0.4 }
        }
      }
    }
    rectangle edgeBottom {
      position: (270, 98), origin: (1, 0.5), size: (130, 3), color: #ffb547
      scale: (0, 1)
      sequence {
        animate { property: scale, to: (0, 1), duration: 0.65 }
        animate { property: scale, to: (1, 1), duration: 0.5, easing: easeOut }
        animate { property: scale, to: (1, 1), duration: 3.55 }
        parallel {
          animate { property: scale, to: (0, 1), duration: 0.4, easing: easeIn }
          animate { property: alpha, to: 0, duration: 0.4 }
        }
      }
    }

    // The title rises 26 px as it fades in: a `parallel` step, so
    // the move and the fade start together. The fade is shorter, so
    // the title is solid before it settles. It leaves upwards.
    text title {
      position: (0, 26), content: "MOTION, WRITTEN", fontSize: 60, color: #f4efe6
      alpha: 0
      sequence {
        animate { property: alpha, to: 0, duration: 0.6 }
        parallel {
          animate { property: position, to: (0, 0), duration: 0.8, easing: easeOut }
          animate { property: alpha, to: 1, duration: 0.6 }
        }
        animate { property: alpha, to: 1, duration: 3.4 }
        parallel {
          animate { property: position, to: (0, -14), duration: 0.45, easing: easeIn }
          animate { property: alpha, to: 0, duration: 0.45 }
        }
      }
    }

    // The underline draws from the title's left edge to its right:
    // 540 px is the title's width, 15 characters at 0.6 of 60 px.
    rectangle underline {
      position: (-270, 40), origin: (0, 0.5), size: (540, 3), color: #f4efe6
      scale: (0, 1)
      sequence {
        animate { property: scale, to: (0, 1), duration: 1.3 }
        animate { property: scale, to: (1, 1), duration: 0.5 }
        animate { property: scale, to: (1, 1), duration: 2.8 }
        animate { property: alpha, to: 0, duration: 0.4 }
      }
    }

    text subtitle {
      position: (-290, 72), origin: (0, 0.5), content: "every move in its own step", fontSize: 18, color: #9aa3b5
      alpha: 0
      sequence {
        animate { property: alpha, to: 0, duration: 1.7 }
        parallel {
          animate { property: position, to: (-270, 72), duration: 0.6, easing: easeOut }
          animate { property: alpha, to: 1, duration: 0.6 }
        }
        animate { property: alpha, to: 1, duration: 2.1 }
        animate { property: alpha, to: 0, duration: 0.4 }
      }
    }
  }
}
