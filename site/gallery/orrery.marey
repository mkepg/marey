// A brass orrery under the stars. Three planets ride arms
// around a lamp of a sun, the middle one carries a moon, and
// every planet turns on its own axis as it goes.
//
// The whole machine is groups inside groups, and each group
// does one job. An orbit group sits on the sun and turns: its
// arm and its planet are its children, so turning the group
// carries them round. Inside it, the planet's own group turns
// its surface. Inside that orbit again, the moon's group turns
// round the planet. Each group's motion is written once, in
// its own space, and the nesting adds them up.
//
// Every turn is `linear`, 360 degrees, with `loop: true`, and
// its period (12, 6, 4, 3 or 2 s) divides the scene's 12 s.
// Nothing is delayed, so the last frame matches the first.

scene {
  size: (960, 540)
  duration: 12
  background: #070a18

  // ── Sky ── Two clouds of colour. Each is two overlapping stacks
  // of faint circles, the second stack off to one side, so the
  // cloud has an uneven shape rather than a round one. Within a
  // stack every circle has the same low alpha and the radii fall
  // in even steps, so the colour deepens towards the middle with
  // no edge to see.
  circle nebulaA8 { position: (130, 100), radius: 320, color: #5b3a96, alpha: 0.03 }
  circle nebulaA7 { position: (130, 100), radius: 280, color: #5b3a96, alpha: 0.03 }
  circle nebulaA6 { position: (130, 100), radius: 240, color: #5b3a96, alpha: 0.03 }
  circle nebulaA5 { position: (130, 100), radius: 200, color: #5b3a96, alpha: 0.03 }
  circle nebulaA4 { position: (130, 100), radius: 162, color: #5b3a96, alpha: 0.03 }
  circle nebulaA3 { position: (130, 100), radius: 126, color: #5b3a96, alpha: 0.03 }
  circle nebulaA2 { position: (130, 100), radius: 92, color: #5b3a96, alpha: 0.03 }
  circle nebulaA1 { position: (130, 100), radius: 60, color: #5b3a96, alpha: 0.03 }
  circle nebulaC4 { position: (40, 250), radius: 190, color: #7a3f8f, alpha: 0.03 }
  circle nebulaC3 { position: (40, 250), radius: 150, color: #7a3f8f, alpha: 0.03 }
  circle nebulaC2 { position: (40, 250), radius: 112, color: #7a3f8f, alpha: 0.03 }
  circle nebulaC1 { position: (40, 250), radius: 76, color: #7a3f8f, alpha: 0.03 }
  circle nebulaB8 { position: (850, 460), radius: 320, color: #1d6f86, alpha: 0.03 }
  circle nebulaB7 { position: (850, 460), radius: 280, color: #1d6f86, alpha: 0.03 }
  circle nebulaB6 { position: (850, 460), radius: 240, color: #1d6f86, alpha: 0.03 }
  circle nebulaB5 { position: (850, 460), radius: 200, color: #1d6f86, alpha: 0.03 }
  circle nebulaB4 { position: (850, 460), radius: 162, color: #1d6f86, alpha: 0.03 }
  circle nebulaB3 { position: (850, 460), radius: 126, color: #1d6f86, alpha: 0.03 }
  circle nebulaB2 { position: (850, 460), radius: 92, color: #1d6f86, alpha: 0.03 }
  circle nebulaB1 { position: (850, 460), radius: 60, color: #1d6f86, alpha: 0.03 }
  circle nebulaD4 { position: (930, 330), radius: 180, color: #2a8a9a, alpha: 0.03 }
  circle nebulaD3 { position: (930, 330), radius: 140, color: #2a8a9a, alpha: 0.03 }
  circle nebulaD2 { position: (930, 330), radius: 104, color: #2a8a9a, alpha: 0.03 }
  circle nebulaD1 { position: (930, 330), radius: 70, color: #2a8a9a, alpha: 0.03 }

  // Stars of three sizes. A few twinkle: alpha yoyo loops whose
  // periods, twice their durations, are 2, 3, 4 and 6 s.
  circle s1  { position: (26, 132),   radius: 1.2, color: #dfe6ff, alpha: 0.8 }
  circle s2  { position: (96, 152),  radius: 0.9, color: #dfe6ff, alpha: 0.6 }
  circle s3  { position: (196, 40),  radius: 1.6, color: #fff3d6
               animate { property: alpha, to: 0.25, duration: 1.5, loop: true, yoyo: true } }
  circle s4  { position: (208, 196), radius: 1, color: #dfe6ff, alpha: 0.7 }
  circle s5  { position: (262, 28),  radius: 1.3, color: #dfe6ff, alpha: 0.9 }
  circle s6  { position: (318, 112), radius: 0.8, color: #dfe6ff, alpha: 0.5 }
  circle s7  { position: (60, 258),  radius: 1.4, color: #cfe0ff
               animate { property: alpha, to: 0.2, duration: 2, loop: true, yoyo: true } }
  circle s8  { position: (132, 330), radius: 0.9, color: #dfe6ff, alpha: 0.6 }
  circle s9  { position: (24, 398),  radius: 1.1, color: #dfe6ff, alpha: 0.7 }
  circle s10 { position: (190, 412), radius: 1.5, color: #fff3d6, alpha: 0.85 }
  circle s11 { position: (96, 516),  radius: 1, color: #dfe6ff, alpha: 0.6 }
  circle s12 { position: (226, 490), radius: 0.8, color: #dfe6ff, alpha: 0.5 }
  circle s13 { position: (372, 40),  radius: 1, color: #dfe6ff, alpha: 0.6 }
  circle s14 { position: (430, 92),  radius: 1.4, color: #cfe0ff
               animate { property: alpha, to: 0.3, duration: 3, loop: true, yoyo: true } }
  circle s15 { position: (546, 18),  radius: 1.1, color: #dfe6ff, alpha: 0.75 }
  circle s16 { position: (604, 86),  radius: 0.8, color: #dfe6ff, alpha: 0.5 }
  circle s17 { position: (672, 30),  radius: 1.6, color: #fff3d6
               animate { property: alpha, to: 0.2, duration: 1, loop: true, yoyo: true } }
  circle s18 { position: (742, 128), radius: 1, color: #dfe6ff, alpha: 0.7 }
  circle s19 { position: (806, 52),  radius: 1.3, color: #dfe6ff, alpha: 0.85 }
  circle s20 { position: (872, 160), radius: 0.9, color: #dfe6ff, alpha: 0.55 }
  circle s21 { position: (930, 30),  radius: 1.2, color: #dfe6ff, alpha: 0.8 }
  circle s22 { position: (918, 236), radius: 1.5, color: #cfe0ff
               animate { property: alpha, to: 0.25, duration: 2, loop: true, yoyo: true } }
  circle s23 { position: (842, 300), radius: 0.8, color: #dfe6ff, alpha: 0.5 }
  circle s24 { position: (938, 364), radius: 1, color: #dfe6ff, alpha: 0.65 }
  circle s25 { position: (780, 420), radius: 1.3, color: #fff3d6, alpha: 0.8 }
  circle s26 { position: (900, 508), radius: 0.9, color: #dfe6ff, alpha: 0.6 }
  circle s27 { position: (700, 512), radius: 1.4, color: #dfe6ff
               animate { property: alpha, to: 0.3, duration: 1.5, loop: true, yoyo: true } }
  circle s28 { position: (612, 470), radius: 0.8, color: #dfe6ff, alpha: 0.5 }
  circle s29 { position: (360, 504), radius: 1.1, color: #dfe6ff, alpha: 0.7 }
  circle s30 { position: (300, 400), radius: 0.8, color: #dfe6ff, alpha: 0.45 }
  circle s31 { position: (402, 180), radius: 0.9, color: #dfe6ff, alpha: 0.5 }
  circle s32 { position: (566, 196), radius: 1, color: #dfe6ff, alpha: 0.55 }
  circle s33 { position: (640, 360), radius: 0.8, color: #dfe6ff, alpha: 0.45 }
  circle s34 { position: (346, 300), radius: 1.2, color: #cfe0ff, alpha: 0.6 }
  circle s35 { position: (690, 230), radius: 1.1, color: #dfe6ff, alpha: 0.6 }
  circle s36 { position: (520, 430), radius: 0.9, color: #dfe6ff, alpha: 0.5 }

  // ── The machine ── One group on the sun holds everything that
  // turns, so moving or turning this group would move or turn
  // the whole orrery.
  group system {
    position: (480, 270)

    // ── Base ── The machine stands on a round brass-rimmed dial,
    // seen from above, held by a bar that runs out to a foot on
    // each side. The bar is written first, so the dial covers its
    // middle. Every part is written about the sun at (0, 0).
    rectangle stand  { position: (0, 0), size: (740, 12), color: #4d3c22 }
    rectangle standHi { position: (0, -3), size: (740, 3), color: #8a6a35 }
    circle footL     { position: (-370, 0), radius: 18, color: #4d3c22 }
    circle footLTop  { position: (-370, 0), radius: 13, color: #8a6a35 }
    circle footLBolt { position: (-370, 0), radius: 5, color: #c9a25a }
    circle footR     { position: (370, 0), radius: 18, color: #4d3c22 }
    circle footRTop  { position: (370, 0), radius: 13, color: #8a6a35 }
    circle footRBolt { position: (370, 0), radius: 5, color: #c9a25a }

    // The dial casts a soft shadow down and to the right: two dark
    // circles at low alpha, offset from the dial's centre.
    circle shadow2 { position: (12, 16), radius: 262, color: #000000, alpha: 0.25 }
    circle shadow1 { position: (8, 11), radius: 256, color: #000000, alpha: 0.3 }

    // The rim is drawing order alone: a brass circle, a thin bright
    // one just inside it, then the dark face on top, each smaller
    // than the last, so only a ring of each shows. The orbit guides
    // below are made the same way.
    circle rim     { position: (0, 0), radius: 255, color: #8a6a35 }
    circle rimEdge { position: (0, 0), radius: 250, color: #c9a25a }
    circle dial    { position: (0, 0), radius: 248.5, color: #15121d }

    // A tick every 10 degrees reads the dial as an instrument. A
    // tick is a short bar on the radius: placed at its middle and
    // turned by its own angle, so its length points at the sun.
    rectangle tick0 { position: (242, 0), size: (12, 2), rotation: 0, color: #c9a25a }
    rectangle tick10 { position: (241, 42), size: (7, 1), rotation: 10, color: #c9a25a, alpha: 0.6 }
    rectangle tick20 { position: (230, 84), size: (7, 1), rotation: 20, color: #c9a25a, alpha: 0.6 }
    rectangle tick30 { position: (210, 121), size: (12, 2), rotation: 30, color: #c9a25a }
    rectangle tick40 { position: (187, 157), size: (7, 1), rotation: 40, color: #c9a25a, alpha: 0.6 }
    rectangle tick50 { position: (157, 187), size: (7, 1), rotation: 50, color: #c9a25a, alpha: 0.6 }
    rectangle tick60 { position: (121, 210), size: (12, 2), rotation: 60, color: #c9a25a }
    rectangle tick70 { position: (84, 230), size: (7, 1), rotation: 70, color: #c9a25a, alpha: 0.6 }
    rectangle tick80 { position: (42, 241), size: (7, 1), rotation: 80, color: #c9a25a, alpha: 0.6 }
    rectangle tick90 { position: (0, 242), size: (12, 2), rotation: 90, color: #c9a25a }
    rectangle tick100 { position: (-42, 241), size: (7, 1), rotation: 100, color: #c9a25a, alpha: 0.6 }
    rectangle tick110 { position: (-84, 230), size: (7, 1), rotation: 110, color: #c9a25a, alpha: 0.6 }
    rectangle tick120 { position: (-121, 210), size: (12, 2), rotation: 120, color: #c9a25a }
    rectangle tick130 { position: (-157, 187), size: (7, 1), rotation: 130, color: #c9a25a, alpha: 0.6 }
    rectangle tick140 { position: (-187, 157), size: (7, 1), rotation: 140, color: #c9a25a, alpha: 0.6 }
    rectangle tick150 { position: (-210, 121), size: (12, 2), rotation: 150, color: #c9a25a }
    rectangle tick160 { position: (-230, 84), size: (7, 1), rotation: 160, color: #c9a25a, alpha: 0.6 }
    rectangle tick170 { position: (-241, 42), size: (7, 1), rotation: 170, color: #c9a25a, alpha: 0.6 }
    rectangle tick180 { position: (-242, 0), size: (12, 2), rotation: 180, color: #c9a25a }
    rectangle tick190 { position: (-241, -42), size: (7, 1), rotation: 190, color: #c9a25a, alpha: 0.6 }
    rectangle tick200 { position: (-230, -84), size: (7, 1), rotation: 200, color: #c9a25a, alpha: 0.6 }
    rectangle tick210 { position: (-210, -121), size: (12, 2), rotation: 210, color: #c9a25a }
    rectangle tick220 { position: (-187, -157), size: (7, 1), rotation: 220, color: #c9a25a, alpha: 0.6 }
    rectangle tick230 { position: (-157, -187), size: (7, 1), rotation: 230, color: #c9a25a, alpha: 0.6 }
    rectangle tick240 { position: (-121, -210), size: (12, 2), rotation: 240, color: #c9a25a }
    rectangle tick250 { position: (-84, -230), size: (7, 1), rotation: 250, color: #c9a25a, alpha: 0.6 }
    rectangle tick260 { position: (-42, -241), size: (7, 1), rotation: 260, color: #c9a25a, alpha: 0.6 }
    rectangle tick270 { position: (0, -242), size: (12, 2), rotation: 270, color: #c9a25a }
    rectangle tick280 { position: (42, -241), size: (7, 1), rotation: 280, color: #c9a25a, alpha: 0.6 }
    rectangle tick290 { position: (84, -230), size: (7, 1), rotation: 290, color: #c9a25a, alpha: 0.6 }
    rectangle tick300 { position: (121, -210), size: (12, 2), rotation: 300, color: #c9a25a }
    rectangle tick310 { position: (157, -187), size: (7, 1), rotation: 310, color: #c9a25a, alpha: 0.6 }
    rectangle tick320 { position: (187, -157), size: (7, 1), rotation: 320, color: #c9a25a, alpha: 0.6 }
    rectangle tick330 { position: (210, -121), size: (12, 2), rotation: 330, color: #c9a25a }
    rectangle tick340 { position: (230, -84), size: (7, 1), rotation: 340, color: #c9a25a, alpha: 0.6 }
    rectangle tick350 { position: (241, -42), size: (7, 1), rotation: 350, color: #c9a25a, alpha: 0.6 }

    // The orbit guides are 1 px rings cut the same way: a circle in
    // the guide's colour, then one 1 px smaller in the colour of the
    // face under it. The guide's colour is brass at a fifth of its
    // strength, worked out against that face, so it reads as a faint
    // engraved line. The inner face is a shade lighter.
    circle guide3   { position: (0, 0), radius: 236.5, color: #3d322a }
    circle face3    { position: (0, 0), radius: 235.5, color: #15121d }
    circle faceIn   { position: (0, 0), radius: 200, color: #18141f }
    circle guide2   { position: (0, 0), radius: 162.5, color: #3f332c }
    circle face2    { position: (0, 0), radius: 161.5, color: #18141f }
    circle guide1   { position: (0, 0), radius: 92.5, color: #3f332c }
    circle face1    { position: (0, 0), radius: 91.5, color: #18141f }

    // The sun's light: twelve faint circles, each step of alpha
    // small enough that no edge shows. They are one group, so a
    // single `animate` on the group's `scale` makes the whole
    // glow breathe. Period 6 s: `duration: 3` with `yoyo`.
    group corona {
      animate { property: scale, to: 1.08, duration: 3, loop: true, yoyo: true }
      circle glow12 { position: (0, 0), radius: 156, color: #ffb347, alpha: 0.03 }
      circle glow11 { position: (0, 0), radius: 144, color: #ffb347, alpha: 0.03 }
      circle glow10 { position: (0, 0), radius: 132, color: #ffb347, alpha: 0.03 }
      circle glow9 { position: (0, 0), radius: 120, color: #ffb84f, alpha: 0.03 }
      circle glow8 { position: (0, 0), radius: 108, color: #ffbd5c, alpha: 0.03 }
      circle glow7 { position: (0, 0), radius: 97, color: #ffc46b, alpha: 0.03 }
      circle glow6 { position: (0, 0), radius: 86, color: #ffc46b, alpha: 0.03 }
      circle glow5 { position: (0, 0), radius: 76, color: #ffcc78, alpha: 0.03 }
      circle glow4 { position: (0, 0), radius: 66, color: #ffd27a, alpha: 0.03 }
      circle glow3 { position: (0, 0), radius: 56, color: #ffd88a, alpha: 0.03 }
      circle glow2 { position: (0, 0), radius: 47, color: #ffdc93, alpha: 0.03 }
      circle glow1 { position: (0, 0), radius: 38, color: #ffe4a8, alpha: 0.03 }
    }

    // ── Outer planet, one turn in 12 s ── The orbit group sits on
    // the sun, so its (0, 0), its pivot, is the sun's centre. The
    // arm and the planet are placed along its x axis; turning the
    // group from 250 to 610 degrees carries both once round.
    // Outer orbits are written first, so the inner arms pass over
    // them, as the arms of a real orrery stack.
    group orbit3 {
      rotation: 250
      animate { property: rotation, to: 610, duration: 12, easing: linear, loop: true }
      rectangle arm3    { position: (118, 0), size: (236, 3), color: #a8844a }

      // The planet's group is placed at the arm's end. It does not
      // turn, so its axes stay the orbit's: the sun is always to
      // its left, at -x. That is where the shade is drawn.
      group planet3 {
        position: (236, 0)
        circle collar3 { position: (0, 0), radius: 27, color: #8a6a35 }
        circle body3   { position: (0, 0), radius: 24, color: #b79be0 }

        // The surface turns inside the planet: two bands and a
        // storm, written about the planet's centre. 360 degrees in
        // 4 s, on top of the orbit's own turn.
        group surface3 {
          animate { property: rotation, to: 360, duration: 4, easing: linear, loop: true }
          polygon bandA3 { position: (0, -12), color: #8f73c9
                           points: [(-18.7, -3), (18.7, -3), (22.2, 3), (-22.2, 3)] }
          polygon bandB3 { position: (0, 5), color: #d9c6f2
                           points: [(-23.9, -3), (23.9, -3), (22.6, 3), (-22.6, 3)] }
          circle  storm3 { position: (9, 12), radius: 4, color: #e58f7a }
        }

        // The night side: a half disc pointing away from the sun.
        // `origin: (0, 0.5)` puts its pivot on its straight edge, at
        // the planet's centre.
        polygon night3 { position: (0, 0), origin: (0, 0.5), color: #070a18, alpha: 0.55
          points: [(0, -24), (6.2, -23.2), (12, -20.8), (17, -17), (20.8, -12), (23.2, -6.2), (24, 0),
                   (23.2, 6.2), (20.8, 12), (17, 17), (12, 20.8), (6.2, 23.2), (0, 24)] }
      }
    }

    // ── Middle planet, one turn in 6 s, with a moon ──
    group orbit2 {
      rotation: 150
      animate { property: rotation, to: 510, duration: 6, easing: linear, loop: true }
      rectangle arm2    { position: (81, 0), size: (162, 3), color: #a8844a }

      group planet2 {
        position: (162, 0)
        circle collar2 { position: (0, 0), radius: 21, color: #8a6a35 }
        circle body2   { position: (0, 0), radius: 18, color: #3d8fc0 }

        // An ocean world: a continent and a cloud band, turning
        // once every 3 s.
        group surface2 {
          animate { property: rotation, to: 360, duration: 3, easing: linear, loop: true }
          polygon land2  { position: (-4, 2), color: #6fbf8a
                           points: [(-6, -7), (1, -8), (6, -4), (7, 2), (3, 8), (-3, 6), (-7, 1)] }
          polygon cloud2 { position: (0, -11.5), color: #e6f5fa, alpha: 0.75
                           points: [(-12.4, -1.5), (12.4, -1.5), (14.9, 1.5), (-14.9, 1.5)] }
        }
        polygon night2 { position: (0, 0), origin: (0, 0.5), color: #070a18, alpha: 0.55
          points: [(0, -18), (4.7, -17.4), (9, -15.6), (12.7, -12.7), (15.6, -9), (17.4, -4.7), (18, 0),
                   (17.4, 4.7), (15.6, 9), (12.7, 12.7), (9, 15.6), (4.7, 17.4), (0, 18)] }

        // The moon's orbit is a group inside the planet, so its
        // pivot is the planet's centre and it is carried round the
        // sun with the planet: two turns, one inside the other.
        // Its crater faces the planet and turns with this group, so
        // the moon always shows the planet the same face.
        group moonOrbit {
          animate { property: rotation, to: 360, duration: 3, easing: linear, loop: true }
          rectangle moonArm { position: (27.5, 0), size: (13, 1.5), color: #a8844a }
          circle moon       { position: (34, 0), radius: 6, color: #d9dde6 }
          circle crater     { position: (31.5, 1), radius: 1.6, color: #9aa1b2 }

          // The moon's night side must face away from the sun, not
          // turn with the moon's orbit. This group turns the other
          // way at the same rate: -360 against 360, so the two
          // cancel and its axes are the planet's again.
          group moonLight {
            position: (34, 0)
            animate { property: rotation, to: -360, duration: 3, easing: linear, loop: true }
            polygon moonNight { position: (0, 0), origin: (0, 0.5), color: #070a18, alpha: 0.6
              points: [(0, -6), (1.6, -5.8), (3, -5.2), (4.2, -4.2), (5.2, -3), (5.8, -1.6), (6, 0),
                       (5.8, 1.6), (5.2, 3), (4.2, 4.2), (3, 5.2), (1.6, 5.8), (0, 6)] }
          }
        }
      }
    }

    // ── Inner planet, one turn in 4 s ──
    group orbit1 {
      rotation: 30
      animate { property: rotation, to: 390, duration: 4, easing: linear, loop: true }
      rectangle arm1    { position: (46, 0), size: (92, 3), color: #a8844a }

      group planet1 {
        position: (92, 0)
        circle collar1 { position: (0, 0), radius: 16, color: #8a6a35 }
        circle body1   { position: (0, 0), radius: 13, color: #e07a4f }

        // A small hot world with one dark band and a crater,
        // turning once every 2 s.
        group surface1 {
          animate { property: rotation, to: 360, duration: 2, easing: linear, loop: true }
          polygon band1   { position: (0, -4), color: #a94a32
                            points: [(-11.5, -2), (11.5, -2), (12.8, 2), (-12.8, 2)] }
          circle  crater1 { position: (5, 5), radius: 2.5, color: #a94a32 }
        }
        polygon night1 { position: (0, 0), origin: (0, 0.5), color: #070a18, alpha: 0.55
          points: [(0, -13), (3.4, -12.6), (6.5, -11.3), (9.2, -9.2), (11.3, -6.5), (12.6, -3.4), (13, 0),
                   (12.6, 3.4), (11.3, 6.5), (9.2, 9.2), (6.5, 11.3), (3.4, 12.6), (0, 13)] }
      }
    }

    // The sun sits in a brass cup over the arms' roots: written
    // last in the machine, so it is drawn over all of them.
    circle cup     { position: (0, 0), radius: 36, color: #8a6a35 }
    circle cupRim  { position: (0, 0), radius: 33, color: #c9a25a }
    circle sunEdge { position: (0, 0), radius: 30, color: #ff9a3c }
    circle sunBody { position: (0, 0), radius: 26, color: #ffc861 }
    circle sunCore { position: (0, 0), radius: 17, color: #ffe8a8 }
    circle sunHot  { position: (-5, -5), radius: 7, color: #fff8e6 }
  }

  // ── Key ── One turn of each arm, in the planets' colours.
  text keyHead { position: (36, 34), origin: (0, 0.5), content: "ONE TURN", fontSize: 12, color: #8a90b0 }
  circle key1  { position: (42, 58), radius: 5, color: #e07a4f }
  text keyT1   { position: (56, 58), origin: (0, 0.5), content: "4 s", fontSize: 13, color: #c9cde0 }
  circle key2  { position: (42, 78), radius: 5, color: #3d8fc0 }
  text keyT2   { position: (56, 78), origin: (0, 0.5), content: "6 s, its moon 3 s", fontSize: 13, color: #c9cde0 }
  circle key3  { position: (42, 98), radius: 5, color: #b79be0 }
