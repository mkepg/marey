// Colour animation across every output (Phase 7). Four shapes, each animating
// `color`; `duration: 2` is 60 frames at 30 fps, so frame N is tick N * 4.
//
// - swatch: a two-step sequence; the second step starts from the colour the
//   first left, with the step boundary at tick 120.
// - pulse: a looping yoyo with a 60-tick leg, so its phase repeats every 120
//   ticks and the sampled frames land on both legs.
// - stroke: a thick diagonal line; its midpoint is (650, 300).
// - label: text, whose glyph has no reliable centre pixel, so it is compared
//   between Lottie and PNG only.
scene {
  size: (800, 600)
  background: #080811
  duration: 2

  rectangle swatch {
    position: (200, 300)
    size: (160, 160)
    color: red
    sequence {
      animate { property: color, to: blue, duration: 1, easing: easeInOut }
      animate { property: color, to: #00ff80, duration: 1, easing: easeInOut }
    }
  }

  circle pulse {
    position: (450, 300)
    radius: 70
    color: #202020
    animate { property: color, to: yellow, duration: 0.5, easing: linear, loop: true, yoyo: true }
  }

  line stroke {
    position: (650, 300)
    points: [(-90, -100), (90, 100)]
    thickness: 24
    color: white
    animate { property: color, to: magenta, duration: 2, easing: linear }
  }

  text label {
    position: (400, 520)
    content: "colour"
    fontSize: 48
    color: cyan
    animate { property: color, to: orange, duration: 2, easing: easeIn }
  }
}
