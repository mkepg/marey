// Fitted-keyframe probe fixture: an easeOut move that hands its exit velocity to a zero-gravity physics body.
scene {
  size: (960, 540)
  duration: 3
  background: #0f172a

  rectangle box {
    position: (160, 270)
    size: (80, 80)
    color: #38bdf8
    animate { property: position, to: (800, 270), duration: 2, easing: easeOut, handoff: true }
    animate { property: color, to: #f97316, duration: 2, easing: easeOut }
    physics { gravity: (0, 0), collideBounds: false, duration: indefinitely }
  }
}
